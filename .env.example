# Copy to .env and fill in. Never share .env.

# Local model (Ollama)
LOCAL_MODEL=qwen3:4b-instruct

# Azure (screen control). Leave empty to stay 100% local.
# Endpoint looks like https://<your-resource>.openai.azure.com
AZURE_ENDPOINT=
AZURE_API_KEY=
# The deployment name you created in Azure AI Foundry (must accept images)
AZURE_MODEL=

# Extra folders Jarvis may read/write besides your user folder, separated by ';'
JARVIS_FILE_ROOTS=

# Speech-to-text model: tiny / base / small (bigger = better Turkish, slower)
WHISPER_MODEL=base
